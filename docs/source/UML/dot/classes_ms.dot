digraph "classes_ms" {
  rankdir=BT
  charset="utf-8"

  "contextuality.measurement_scenario.GeneralizedMeasurementScenario" [
    color="black",
    fontcolor="black",
    fontname="Courier",
    shape=plain,
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
        <TR><TD ALIGN="CENTER" WIDTH="300"><B>GeneralizedMeasurementScenario</B></TD></TR>
