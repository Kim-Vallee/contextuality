        <TR><TD ALIGN="LEFT" BALIGN="LEFT"></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT">CHSH(): MeasurementScenario<BR/>KCBS(): MeasurementScenario<BR/>PeresMermin(): MeasurementScenario</TD></TR>
