      </TABLE>
    >
  ];

  "contextuality.measurement_scenario.MeasurementScenario" [
    color="black",
    fontcolor="black",
    fontname="Courier",
    shape=plain,
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0">
        <TR><TD ALIGN="CENTER" WIDTH="500"><B>MeasurementScenario</B></TD></TR>
        <TR><TD ALIGN="LEFT" BALIGN="LEFT">M : List[List[Union[Symbol, int]]]<BR/>O : List[int]<BR/>X : List[Union[Symbol, int]]<BR/>all_outcomes : List[Tuple[int]]<BR/>incidence_matrix : ndarray<BR/>incidence_matrix_constrained : ndarray<BR/>incidence_matrix_signalling : ndarray<BR/>outcomes_global : List[List[int]]</TD></TR>
